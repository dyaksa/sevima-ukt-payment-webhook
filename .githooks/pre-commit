#!/bin/sh
# Project guards for every commit, human or agent. Enable once per clone:
#   git config core.hooksPath .githooks

# CLAUDE.md hard limit 6: committed migrations are history. Adding a new one is fine.
changed=$(git diff --cached --name-only --diff-filter=MDR -- database/migrations)
if [ -n "$changed" ]; then
    echo "pre-commit: these migrations are already committed; add a new migration instead:" >&2
    echo "$changed" >&2
    exit 1
fi

# CLAUDE.md hard limit 3: a 64-hex string is the shape of an HMAC secret (heuristic).
if git diff --cached -U0 | grep '^+' | grep -v '^+++' | grep -Eiq '\b[0-9a-f]{64}\b'; then
    echo "pre-commit: the staged changes contain a 64-hex string that looks like an HMAC secret." >&2
    exit 1
fi

# Keep running a global pre-commit hook (core.hooksPath set in the global config),
# because this repo's local core.hooksPath replaces it.
global_hooks=$(git config --global --get core.hooksPath)
if [ -n "$global_hooks" ] && [ -x "$global_hooks/pre-commit" ]; then
    exec "$global_hooks/pre-commit" "$@"
fi

exit 0
